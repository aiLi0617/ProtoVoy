PROTOVOY_DATABASE_PASSWORD=replace-with-a-long-random-database-password
PROTOVOY_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
PROTOVOY_AGENT_TOKEN=replace-with-a-long-random-agent-token
PROTOVOY_GATEWAY_API_KEY=replace-with-a-separate-long-random-api-key
PROTOVOY_GATEWAY_MAX_CONCURRENCY=16
PROTOVOY_WEB_PORT=8080
PROTOVOY_PUBLIC_ORIGIN=http://localhost:8080

# Optional enterprise OIDC
PROTOVOY_SSO_ENABLED=false
PROTOVOY_SSO_ORGANIZATION_ID=
PROTOVOY_OIDC_CLIENT_ID=
PROTOVOY_OIDC_CLIENT_SECRET=
