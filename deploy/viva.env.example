# Copy to deploy/.env.viva. Point to a file containing a unique password
# of at least 24 printable characters, readable by container UID 65532.
PROTOVOY_WEB_USER=operator
PROTOVOY_VIVA_PASSWORD_FILE=

# The certificate must cover this origin. Use absolute paths on the Docker host.
PROTOVOY_VIVA_ORIGIN=https://localhost:8443
PROTOVOY_VIVA_TLS_CERT=
PROTOVOY_VIVA_TLS_KEY=

# The host listener defaults to loopback.
PROTOVOY_VIVA_BIND=127.0.0.1
PROTOVOY_VIVA_PORT=8443

# Optional endpoints reachable from the container.
PROTOVOY_VIVA_HTTP_TARGET=
PROTOVOY_VIVA_WEBSOCKET_TARGET=
PROTOVOY_VIVA_TCP_TARGET=
PROTOVOY_VIVA_UDP_TARGET=
PROTOVOY_VIVA_GRPC_TARGET=

# Optional fixed Redis endpoint. TLS uses the container's trusted roots.
PROTOVOY_VIVA_REDIS_TARGET=
PROTOVOY_VIVA_REDIS_USERNAME=
PROTOVOY_VIVA_REDIS_DB=
PROTOVOY_VIVA_REDIS_TLS=true
PROTOVOY_VIVA_REDIS_SERVER_NAME=
PROTOVOY_REDIS_PASSWORD=
PROTOVOY_REDIS_PASSWORD_REF=

# Optional fixed brokers. Use TLS URLs for named passwords.
PROTOVOY_VIVA_MQTT_TARGET=
PROTOVOY_VIVA_MQTT_USERNAME=
PROTOVOY_VIVA_MQTT_SERVER_NAME=
PROTOVOY_MQTT_PASSWORD=
PROTOVOY_MQTT_PASSWORD_REF=
PROTOVOY_VIVA_AMQP_TARGET=
PROTOVOY_VIVA_AMQP_USERNAME=
PROTOVOY_VIVA_AMQP_SERVER_NAME=
PROTOVOY_AMQP_PASSWORD=
PROTOVOY_AMQP_PASSWORD_REF=

# Optional Kafka broker list. Use SASL_SSL for named passwords.
PROTOVOY_VIVA_KAFKA_TARGET=
PROTOVOY_VIVA_KAFKA_SECURITY=SSL
PROTOVOY_VIVA_KAFKA_SASL=
PROTOVOY_VIVA_KAFKA_USERNAME=
PROTOVOY_KAFKA_PASSWORD=
PROTOVOY_KAFKA_PASSWORD_REF=

# Optional SQL endpoint. Keep credentials separate from the URL.
PROTOVOY_VIVA_SQL_TARGET=
PROTOVOY_VIVA_SQL_USERNAME=
PROTOVOY_SQL_PASSWORD=
PROTOVOY_SQL_PASSWORD_REF=

# Set to /var/lib/protovoy/team.db to enable the team API.
PROTOVOY_VIVA_TEAM_DB=
PROTOVOY_TEAM_BOOTSTRAP_TOKEN=

# Set to /var/lib/protovoy/schedules.db to enable recurring jobs.
# Keep separate from team.db and any SQLite SQL target (including sidecars).
PROTOVOY_VIVA_SCHEDULE_DB=
PROTOVOY_VIVA_SCHEDULE_TIMEOUT=30s

# Optional hosted OIDC settings. Configure after team bootstrap.
PROTOVOY_TEAM_OIDC_ISSUER=
PROTOVOY_TEAM_OIDC_CLIENT_ID=
PROTOVOY_TEAM_OIDC_CLIENT_SECRET=
PROTOVOY_TEAM_OIDC_ORGANIZATION_ID=
PROTOVOY_TEAM_OIDC_DEFAULT_ROLE=
