{
  "name": "protovoy",
  "private": true,
  "version": "0.2.0",
  "description": "ProtoVoy — Explore Every Protocol. Local-first multi-protocol API client.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:web": "pnpm --filter @protovoy/web dev",
    "build:web": "pnpm --filter @protovoy/web build",
    "dev:desktop": "pnpm --filter @protovoy/desktop tauri:dev",
    "build:desktop": "pnpm --filter @protovoy/desktop tauri:build",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "validate:changed": "node scripts/validate-changed.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter=!@protovoy/ui -r test && node scripts/run-tsx-tests.mjs --cwd packages/ui --concurrency 4",
    "test:e2e": "playwright test",
    "test:e2e:changed": "node scripts/test-changed-e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": "3.4.13",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
