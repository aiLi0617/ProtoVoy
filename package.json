{
  "name": "protovoy",
  "private": true,
  "version": "0.1.0",
  "description": "ProtoVoy — Explore Every Protocol. Local-first multi-protocol API client.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:web": "go -C apps/protovoy-go tool viva build --target web -o build/web && go -C apps/protovoy-go run -mod=readonly ./cmd/server",
    "build:web": "go -C apps/protovoy-go tool viva build --target web -o build/web",
    "dev:desktop": "go -C apps/protovoy-go run -mod=readonly ./cmd/workbench",
    "build:desktop": "go -C apps/protovoy-go build -mod=readonly -trimpath -o build/native/ ./cmd/workbench",
    "dev:web:vite": "pnpm --filter @protovoy/web dev",
    "build:web:vite": "pnpm --filter @protovoy/web build",
    "dev:desktop:tauri": "pnpm --filter @protovoy/desktop tauri:dev",
    "build:desktop:tauri": "pnpm --filter @protovoy/desktop tauri:build",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "validate:changed": "node scripts/validate-changed.mjs",
    "validate:plan": "node scripts/validate-changed.mjs --plan",
    "validate:staged": "node scripts/validate-changed.mjs --staged",
    "validate:since": "node scripts/validate-changed.mjs --since-last-run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter=!@protovoy/ui -r test && node scripts/run-tsx-tests.mjs --cwd packages/ui --concurrency 4",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui --project=desktop-chromium",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:e2e:changed": "node scripts/test-changed-e2e.mjs",
    "test:e2e:staged": "node scripts/test-changed-e2e.mjs --staged",
    "test:e2e:since": "node scripts/test-changed-e2e.mjs --since-last-run",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "rust:check": "cargo check --workspace",
    "rust:test": "cargo test --workspace"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": "3.4.13",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
